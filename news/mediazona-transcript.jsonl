{"start": 81.39, "end": 100.15, "text": " Надеюсь, для вас Хазов и Неволайнин это будет уроком. Не позднее лето 2023 года на релейные шкафы по всей стране начали наносить трафаретные надпись с предупреждениями о наказании за диверсии вплоть до пожизненного. Силовики, которые постоянно публикуют прострелизы о новых задержаниях,", "words": [{"start": 81.39, "end": 82.21, "word": " Надеюсь,"}, {"start": 82.49, "end": 82.51, "word": " для"}, {"start": 82.51, "end": 82.75, "word": " вас"}, {"start": 82.75, "end": 83.31, "word": " Хазов"}, {"start": 83.31, "end": 83.47, "word": " и"}, {"start": 83.47, "end": 84.17, "word": " Неволайнин"}, {"start": 84.17, "end": 84.53, "word": " это"}, {"start": 84.53, "end": 84.77, "word": " будет"}, {"start": 84.77, "end": 85.53, "word": " уроком."}, {"start": 85.63, "end": 85.75, "word": " Не"}, {"start": 85.75, "end": 86.23, "word": " позднее"}, {"start": 86.23, "end": 86.59, "word": " лето"}, {"start": 86.59, "end": 87.21, "word": " 2023"}, {"start": 87.21, "end": 87.79, "word": " года"}, {"start": 87.79, "end": 87.93, "word": " на"}, {"start": 87.93, "end": 88.43, "word": " релейные"}, {"start": 88.43, "end": 88.87, "word": " шкафы"}, {"start": 88.87, "end": 89.01, "word": " по"}, {"start": 89.01, "end": 89.23, "word": " всей"}, {"start": 89.23, "end": 89.73, "word": " стране"}, {"start": 89.73, "end": 90.21, "word": " начали"}, {"start": 90.21, "end": 90.73, "word": " наносить"}, {"start": 90.73, "end": 91.43, "word": " трафаретные"}, {"start": 91.43, "end": 91.93, "word": " надпись"}, {"start": 91.93, "end": 92.09, "word": " с"}, {"start": 92.09, "end": 93.13, "word": " предупреждениями"}, {"start": 93.13, "end": 93.49, "word": " о"}, {"start": 93.49, "end": 94.17, "word": " наказании"}, {"start": 94.17, "end": 94.35, "word": " за"}, {"start": 94.35, "end": 94.95, "word": " диверсии"}, {"start": 94.95, "end": 95.35, "word": " вплоть"}, {"start": 95.35, "end": 95.43, "word": " до"}, {"start": 95.43, "end": 96.19, "word": " пожизнен